<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>au.org.ala.names</groupId>
        <artifactId>ala-name-matching-2</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ala-linnaean-builder</artifactId>
<!--    <version>${project.parent.version}</version>-->

    <name>ALA Linnaean Name Index Builder</name>
    <description>
        Build indexes for the ALA Linnaean network
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>bayesian-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>bayesian-builder</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>taxonomic-tools-builder</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>bayesian-lucene</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>ala-linnaean</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>name-matching-common-test</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
            <version>${jts.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>au.org.ala.maven</groupId>
                <artifactId>bayesian-maven-plugin</artifactId>
                <version>${project.parent.version}</version>
                <executions>
                    <execution>
                        <id>ala-network-build</id>
                        <goals>
                            <goal>generate-network</goal>
                        </goals>
                        <configuration>
                            <source>../ala-linnaean/src/main/resources/ala-linnaean.json</source>
                            <outputPackage>au.org.ala.names</outputPackage>
                            <generateBuilder>true</generateBuilder>
                            <generateCli>true</generateCli>
                            <generateInferencer>false</generateInferencer>
                            <generateParameters>false</generateParameters>
                            <generateClassification>false</generateClassification>
                            <generateFactory>false</generateFactory>
                            <analyserClass>au.org.ala.names.AlaNameAnalyser</analyserClass>
                            <buildAnalyserClass>au.org.ala.names.AlaNameBuildAnalyser</buildAnalyserClass>
                            <weightAnalyserClass>au.org.ala.names.AlaWeightAnalyser</weightAnalyserClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>ala-vernacular-build</id>
                        <goals>
                            <goal>generate-network</goal>
                        </goals>
                        <configuration>
                            <source>../ala-linnaean/src/main/resources/ala-vernacular.json</source>
                            <outputPackage>au.org.ala.names</outputPackage>
                            <generateBuilder>true</generateBuilder>
                            <generateCli>true</generateCli>
                            <generateInferencer>false</generateInferencer>
                            <generateParameters>false</generateParameters>
                            <generateClassification>false</generateClassification>
                            <generateFactory>false</generateFactory>
                            <analyserClass>au.org.ala.names.AlaVernacularAnalyser</analyserClass>
                            <buildAnalyserClass>au.org.ala.names.AlaVernacularBuildAnalyser</buildAnalyserClass>
                        </configuration>
                    </execution>
                <execution>
                    <id>ala-location-build</id>
                    <goals>
                        <goal>generate-network</goal>
                    </goals>
                    <configuration>
                        <source>../ala-linnaean/src/main/resources/ala-location.json</source>
                        <outputPackage>au.org.ala.location</outputPackage>
                        <generateBuilder>true</generateBuilder>
                        <generateCli>true</generateCli>
                        <generateInferencer>false</generateInferencer>
                        <generateParameters>false</generateParameters>
                        <generateClassification>false</generateClassification>
                        <generateFactory>false</generateFactory>
                        <analyserClass>au.org.ala.location.AlaLocationAnalyser</analyserClass>
                        <buildAnalyserClass>au.org.ala.location.AlaLocationBuildAnalyser</buildAnalyserClass>
                        <weightAnalyserClass>au.org.ala.location.AlaLocationWeightAnalyser</weightAnalyserClass>
                    </configuration>
                </execution>
            </executions>
            <dependencies>
                    <dependency>
                        <groupId>${project.parent.groupId}</groupId>
                        <artifactId>ala-linnaean</artifactId>
                        <version>${project.parent.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>${project.parent.groupId}</groupId>
                        <artifactId>taxonomic-tools-builder</artifactId>
                        <version>${project.parent.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>